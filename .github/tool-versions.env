# The versions the gate installs. Pinned, and in one place, for two reasons:
# the gate's verdict must not change because somebody upstream released
# something overnight, and a cache cannot be keyed on `@latest`.
#
# Bumping a line here is what invalidates the tool cache — that is the whole
# mechanism, so bump deliberately and read the tool's changelog first.
# gitleaks was installed from apt with no pin at all, so CI ran 8.16.0
# while a developer's machine ran 8.30.1 — fourteen minor versions apart,
# and they disagree about whether a file contains a secret. The gate gave
# two different verdicts for the same tree, which is the thing this file
# exists to prevent.
GITLEAKS=8.30.1
OSV_SCANNER=v2.5.1
GOLANGCI_LINT=2.13.1
ACTIONLINT=1.7.12
LYCHEE=0.24.2
SCIP=0.9.0
SCIP_GO=v0.2.7
GOPLS=v0.23.0
SEMGREP=1.174.0
RUFF=0.16.4
MKDOCS_MATERIAL=9.7.7
ESLINT=10.8.1
PRETTIER=3.9.6
PRETTIER_PLUGIN_PHP=0.25.0
MERMAID_CLI=11.16.0
