# The versions the gate installs. Pinned, and in one place, for two reasons:
# the gate's verdict must not change because somebody upstream released
# something overnight, and a cache cannot be keyed on `@latest`.
#
# Bumping a line here is what invalidates the tool cache — that is the whole
# mechanism, so bump deliberately and read the tool's changelog first.
OSV_SCANNER=v2.5.1
GOLANGCI_LINT=2.13.1
ACTIONLINT=1.7.12
LYCHEE=0.24.2
SCIP=0.9.0
SCIP_GO=v0.2.7
GOPLS=v0.23.0
SEMGREP=1.174.0
RUFF=0.16.3
MKDOCS_MATERIAL=9.6.23
ESLINT=10.8.1
PRETTIER=3.9.6
PRETTIER_PLUGIN_PHP=0.25.0
MERMAID_CLI=11.16.0
