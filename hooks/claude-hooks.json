{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.sh\" principles --hook",
            "timeout": 15,
            "statusMessage": "procoder principles..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.sh\" hook pre-tool-use",
            "timeout": 120,
            "statusMessage": "procoder gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.sh\" hook post-tool-use",
            "timeout": 60,
            "statusMessage": "procoder format check..."
          }
        ]
      }
    ]
  }
}
